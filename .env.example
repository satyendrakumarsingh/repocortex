# Environment variables cortex reads. All are optional; each has a default.
# Copy to .env.local to set one. Nothing here is required to index or serve.

# Where cortex keeps user-level configuration. Defaults to the platform config
# directory.
CORTEX_CONFIG_HOME=

# Linux and macOS config base, used when CORTEX_CONFIG_HOME is unset.
XDG_CONFIG_HOME=

# Windows application data directory, used by `cortex install` when present.
APPDATA=

# Docker credential directory, read when indexing images that need registry
# credentials. Defaults to ~/.docker.
DOCKER_CONFIG=

# Codex CLI home, read by `cortex install` to find config.toml. Defaults to
# ~/.codex.
CODEX_HOME=

# Kimi Code CLI home, read by `cortex install` to find mcp.json. Defaults to
# ~/.kimi-code.
KIMI_CODE_HOME=

# Bearer token for `cortex serve --http`, at least 24 characters. When unset a
# random token is generated for each run and written to .cortex/mcp-token
# (readable only by you).
CORTEX_MCP_TOKEN=
