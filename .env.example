# Environment variables repocortex reads. All are optional; each has a default.
# Copy to .env.local to set one. Nothing here is required to index or serve.

# Where repocortex keeps user-level configuration. Defaults to the platform config
# directory.
REPOCORTEX_CONFIG_HOME=

# Linux and macOS config base, used when REPOCORTEX_CONFIG_HOME is unset.
XDG_CONFIG_HOME=

# Windows application data directory, used by `repocortex install` when present.
APPDATA=

# Docker credential directory, read when indexing images that need registry
# credentials. Defaults to ~/.docker.
DOCKER_CONFIG=

# Codex CLI home, read by `repocortex install` to find config.toml. Defaults to
# ~/.codex.
CODEX_HOME=

# Kimi Code CLI home, read by `repocortex install` to find mcp.json. Defaults to
# ~/.kimi-code.
KIMI_CODE_HOME=

# Bearer token for `repocortex serve --http`, at least 24 characters. When unset a
# random token is generated for each run and written to .repocortex/mcp-token
# (readable only by you).
REPOCORTEX_MCP_TOKEN=
